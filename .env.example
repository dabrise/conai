# Copy this file to .env and fill in your own values.
# NEVER commit .env to git — only .env.example

# OpenRouter — one key for all LLM providers (GPT, Claude, Gemini, Llama, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_KEY=

# ElevenLabs — for voice synthesis (TTS) in the Cascade voice engine
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_KEY=

# OpenAI — for the Realtime (speech-to-speech) voice engine. Optional.
# Only needed if you use the "Realtime" voice engine. Get your key at:
# https://platform.openai.com/api-keys
OPENAI_KEY=

# Shared password for accessing the tool
APP_PASSWORD=change-me

# Random string used to sign session cookies (change to anything long & random)
SESSION_SECRET=change-this-to-a-random-string

# Set to "production" when deploying on a real server
NODE_ENV=development
